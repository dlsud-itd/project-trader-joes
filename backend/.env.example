# Copy this file to .env and fill in your own values. Never commit .env.

# Local Postgres, or the connection string from Neon (https://neon.tech)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/talentflow

# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Frontend URLs allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:4200

PORT=3000

# AI screening (Gemini). Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: which Gemini model to use (default gemini-3.5-flash)
GEMINI_MODEL=

# Applicant emails (Resend). Get a free key at https://resend.com/api-keys
# Leave empty to turn email off; nothing is sent and nothing breaks.
RESEND_API_KEY=
# Optional sender, e.g. TalentFlow <jobs@yourdomain.com> (domain verified in
# Resend). Default onboarding@resend.dev only delivers to your own address.
EMAIL_FROM=
